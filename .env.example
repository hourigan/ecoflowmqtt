ECOFLOW_API_HOST=https://api-e.ecoflow.com

# Optional: comma-separated list. Leave blank to poll every device returned by EcoFlow.
ECOFLOW_DEVICE_SNS=

# Optional: comma-separated quota names. Leave blank to request all quotas.
ECOFLOW_QUOTAS=

# Optional: extra quota names to request in addition to all quotas.
# Leave blank to probe common STREAM PV/MPPT fields.
ECOFLOW_EXTRA_QUOTAS=

# Seconds to listen to EcoFlow's cloud MQTT stream each poll.
# STREAM devices expose richer MPPT/PV telemetry here than over HTTP.
ECOFLOW_STREAM_SECONDS=20

POLL_INTERVAL_SECONDS=60
HEALTH_STATUS_FILE=/tmp/ecoflow-mqtt-health.json
# Defaults to at least two poll intervals plus stream time. Increase if polling is intentionally slow.
HEALTHCHECK_MAX_AGE_SECONDS=

MQTT_HOST=mqtt.dockerapp.net
MQTT_PORT=1883
MQTT_CLIENT_ID=ecoflow-mqtt
MQTT_TOPIC_PREFIX=ecoflow
MQTT_RETAIN=true
MQTT_PUBLISH_INDIVIDUAL=true

LOG_LEVEL=INFO
